<configuration>
    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="lms-service"/>
    <!--  Use "logging.logstash.*" — NOT "logstash.*" which triggers encoder auto-config  -->
    <springProperty scope="context" name="LOGSTASH_HOST" source="logging.logstash.host" defaultValue="localhost"/>
    <springProperty scope="context" name="LOGSTASH_PORT" source="logging.logstash.port" defaultValue="5044"/>
    <!--  ── Console appender (always active — readable locally) ─────────  -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId},%X{spanId}] [${SERVICE_NAME}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!--  ── Logstash TCP appender (docker profile only) ────────────────  -->
    <springProfile name="docker">
        <appender name="LOGSTASH_TCP" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${LOGSTASH_HOST}:${LOGSTASH_PORT}</destination>
            <!--  Reconnect automatically if Logstash restarts  -->
            <reconnectionDelay>5 seconds</reconnectionDelay>
            <connectionTimeout>3 seconds</connectionTimeout>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${SERVICE_NAME}","env":"docker"}</customFields>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <message>message</message>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <level>level</level>
                </fieldNames>
                <includeContext>true</includeContext>
                <includeMdc>true</includeMdc>
            </encoder>
        </appender>
        <!--  Async wrapper — neverBlock=true prevents app hanging if Logstash is slow  -->
        <appender name="ASYNC_LOGSTASH" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOGSTASH_TCP"/>
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOGSTASH"/>
        </root>
    </springProfile>
    <!--  ── Local dev: plain console only ───────────────────────────────  -->
    <springProfile name="!docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
    <logger name="com.lms" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.springframework.kafka" level="INFO"/>
    <logger name="io.github.resilience4j" level="DEBUG"/>
    <logger name="org.springframework.cloud" level="INFO"/>
</configuration>